# Copy to .env (gitignored) and fill only what you use. Process env overrides .env. Never commit real values.

# --- PandaOmics Agent ---
# PandaOmics Agent MCP endpoint (default https://pandaomics.com/pandaclaw-mcp)
PANDACLAW_MCP_URL=
# PandaOmics Agent bearer token (static PAT); unlocks `plsi oracle pandaclaw`
PANDACLAW_BEARER_TOKEN=

# --- PandaOmics ---
# PandaOmics MCP endpoint (default https://pandaomics.com/mcp)
PANDAOMICS_MCP_URL=
# PandaOmics bearer token; unlocks `plsi oracle pandaomics`
PANDAOMICS_BEARER_TOKEN=

# --- L-LLM (OpenAI-compatible) ---
# Endpoint preset: local -> http://127.0.0.1:1234/v1, server -> http://127.0.0.1:8000/v1
PLSI_LLLM_MODE=
# Explicit OpenAI-compatible base URL (overrides PLSI_LLLM_MODE)
PLSI_LLLM_BASE_URL=
# Served model name (default longevity-llm)
PLSI_LLLM_MODEL=
# Bearer key for the L-LLM endpoint
PLSI_LLLM_API_KEY=
# Hugging Face token, used when PLSI_LLLM_API_KEY is unset
HF_TOKEN=
# 1 enables thinking mode (chat_template_kwargs.enable_thinking; max_tokens 2200)
PLSI_LLLM_ENABLE_THINKING=

# --- LOINC FHIR (optional, unused by default) ---
# loinc.org account username for fhir.loinc.org
LOINC_USERNAME=
# loinc.org account password for fhir.loinc.org
LOINC_PASSWORD=

# --- NCBI ---
# NCBI API key; raises E-utilities from 3 to 10 req/s
NCBI_API_KEY=
# Contact email sent with E-utilities requests (NCBI policy)
NCBI_EMAIL=

# --- openFDA ---
# openFDA API key; raises the daily limit from 1,000 to 120,000 requests
OPENFDA_API_KEY=

# --- Open Wearables (wearables/import; self-hosted) ---
# Your Open Wearables server (default http://localhost:8000)
OPEN_WEARABLES_API_URL=
# Open Wearables API key, also used by its MCP server config
OPEN_WEARABLES_API_KEY=

# --- Google Health (wearables/google-health, nutritionist/food-log) ---
# OAuth client id from the user's own Google Cloud project
GOOGLE_HEALTH_CLIENT_ID=
# OAuth client secret of that client
GOOGLE_HEALTH_CLIENT_SECRET=
# Read-only refresh token; expires in about 7 days while the OAuth app is in Testing
GOOGLE_HEALTH_REFRESH_TOKEN=

# --- FatSecret (nutritionist/food-log) ---
# Platform (developer) account: OAuth 1.0 consumer key
FATSECRET_CONSUMER_KEY=
# Platform (developer) account: OAuth 1.0 shared secret
FATSECRET_CONSUMER_SECRET=
# Member (food app) account: 3-legged OAuth 1.0 access token
FATSECRET_ACCESS_TOKEN=
# Member (food app) account: access token secret
FATSECRET_ACCESS_SECRET=

# --- Longevity Mothership (physicians and researchers) ---
# Professional token (plsp1.) the Mothership steward mints after review; unlocks data releases, findings and prereg
MOTHERSHIP_PROFESSIONAL_TOKEN=

# --- Runtime ---
# Instance directory (default <repo>/instances)
PLSI_HOME=
# 1 prints redacted tracebacks to stderr
PLSI_DEBUG=
# Alternative path of this env file (default <repo>/.env)
PLSI_ENV_FILE=
